APP_NAME="Sound Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Base de datos propia del sistema de sonido. NO usar ferreteria_guisella.
DB_DATABASE=sound_management_db
# En Docker no puede ser root (lo crea la imagen de MySQL). En XAMPP local puede ser root.
DB_USERNAME=sound_app
# Obligatoria con Docker. Usa una contraseña larga y única (no reutilices la de la ferretería).
DB_PASSWORD=

# Solo Docker: contraseña de root de MySQL y puertos publicados en el host (127.0.0.1)
DB_ROOT_PASSWORD=
DB_FORWARD_PORT=3307
APP_PORT=8080

# Usuario MySQL de SOLO LECTURA para reportes con IA (ver docker/mysql/reports-user.sql.example).
# Si se dejan vacíos se usan las credenciales principales.
DB_REPORTS_USERNAME=
DB_REPORTS_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reportes con IA (Groq). Desactivados por defecto; solo administradores.
AI_REPORTS_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_REPORTS_MAX_ROWS=500
AI_REPORTS_TIMEOUT_MS=5000

# Pago en línea del carrito (PayPal). Sin credenciales el checkout en línea queda desactivado.
# El secreto NUNCA debe ir en vistas ni en JavaScript.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del webhook de PayPal (verificación de firmas). Sin él, el pago en línea no se ofrece.
PAYPAL_WEBHOOK_ID=
# Moneda de cobro del proveedor. Los importes de la aplicación son BOB; la conversión
# usa la tasa del día registrada por el administrador (nunca una tasa por defecto).
PAYPAL_CURRENCY=USD

# Minutos tras los que un intento de pago en línea sin aprobar puede expirar
PAGOS_EXPIRACION_MINUTOS=30
